create table if not exists public.news_summaries (
  id bigint generated always as identity primary key,
  news_id text not null unique,
  title text not null,
  summary text not null,
  impact text not null check (impact in ('positivo', 'neutro', 'negativo')),
  lang text not null default 'pt',
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now()
);

alter table public.news_summaries enable row level security;

create policy "news_summaries_public_read"
  on public.news_summaries
  for select
  to anon, authenticated
  using (true);